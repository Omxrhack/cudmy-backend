NODE_ENV=development

# Gateway (HTTP)
GATEWAY_PORT=3000

# NATS (transporte inter-servicios)
NATS_URL=nats://localhost:4222

# PostgreSQL (microservicio auth)
# Si el puerto 5432 ya está ocupado en tu máquina, cambia POSTGRES_PORT
# (p. ej. 5433) y ajusta el puerto en DATABASE_URL para que coincidan.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cudmy:cudmy@localhost:5432/cudmy_auth
POSTGRES_USER=cudmy
POSTGRES_PASSWORD=cudmy
POSTGRES_DB=cudmy_auth

# JWT (usa secretos largos y aleatorios en cada entorno)
ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_TTL=7d

# Verificación (microservicio verification, BD propia)
VERIFICATION_DATABASE_URL=postgresql://cudmy:cudmy@localhost:5432/cudmy_verification
OTP_TTL_SECONDS=600
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Entrega: console (log) | memory (tests) | twilio (SMS) | smtp (correo)
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# Proveedores reales (opcional, para el swap futuro)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
